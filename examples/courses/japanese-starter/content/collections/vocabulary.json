{
  "format": "asakiri-course",
  "formatVersion": 1,
  "id": "collection_vocabulary",
  "name": "Vocabulary",
  "description": "Reusable vocabulary records shown as a table in the Content area.",
  "fields": [
    {
      "id": "field_japanese",
      "name": "Japanese",
      "kind": "text",
      "cardinality": "one",
      "locale": "ja",
