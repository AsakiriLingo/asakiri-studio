{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asakiri Studio",
  "version": "0.4.3",
  "identifier": "com.asakiri.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Asakiri Studio",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["piper"],
    "macOS": {
      "signingIdentity": "Developer ID Application: Alok Ram Singh (6ZBB7468M8)",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AsakiriLingo/asakiri-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFREQ2NTVGNDZBMkEwNEIKUldSTG9LSkdYMlhkUGlNeGFDamR1RUsyanhldXcxb1F1QlJqSVZvd3Qveld2N3ZmeWRQVkZmTUUK"
    }
  }
}
