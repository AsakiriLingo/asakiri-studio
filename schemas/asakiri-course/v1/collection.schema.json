{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asakiri.com/schemas/asakiri-course/v1/collection.schema.json",
  "title": "Content collection",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["format", "formatVersion", "id", "name", "fields", "recordFiles"],
  "properties": {
    "format": true,
    "formatVersion": true,
    "$comment": true,
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "cardinality", "required"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "kind": { "enum": ["text", "asset"] },
          "cardinality": { "enum": ["one", "many"] },
          "required": { "type": "boolean" },
          "locale": { "type": "string" },
          "assetKind": { "enum": ["image", "audio", "video"] }
        },
        "additionalProperties": false
      }
    },
    "recordFiles": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/relativePath" }
    }
  }
}
