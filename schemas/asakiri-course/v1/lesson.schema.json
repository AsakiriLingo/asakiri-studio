{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asakiri.com/schemas/asakiri-course/v1/lesson.schema.json",
  "title": "Lesson (lesson.json)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "required": ["format", "formatVersion", "id", "title", "parts"],
  "properties": {
    "format": true,
    "formatVersion": true,
    "$comment": true,
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "content"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "content": {
            "type": "object",
            "required": ["kind", "file"],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "$ref": "common.schema.json#/$defs/relativePath"
              },
              "title": {
                "$ref": "common.schema.json#/$defs/localizedText"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
