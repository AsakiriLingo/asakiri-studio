{
  "name": "asakiri-studio",
  "private": true,
  "version": "0.3.0",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm check:boundaries && pnpm check:example && pnpm check:schemas && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:rust",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:example": "node scripts/validate-example-course.mjs",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:schemas": "node scripts/check-schemas.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:push": "lokalise2 --config lokalise.yml file upload --file src/shared/i18n/en.json --lang-iso en --detect-icu-plurals --replace-modified --cleanup-mode --poll",
    "i18n:pull": "lokalise2 --config lokalise.yml file download --format json --filter-langs en,es,it,pt,ru,ja --placeholder-format icu --plural-format icu --original-filenames=false --bundle-structure \"src/shared/i18n/%LANG_ISO%.json\" --indentation 2sp && prettier --write \"src/shared/i18n/*.json\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-youtube": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "circle-flags": "^2.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.66.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
